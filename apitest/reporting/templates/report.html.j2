<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>apitest report: {{ report.spec_title }}</title>
<style>
  :root {
    --bg: #f7f7f5; --panel: #ffffff; --text: #1d1d1f; --muted: #6b6b70; --border: #e2e2e0;
    --code-bg: #f1f1ef; --high: #c62828; --medium: #b26a00; --low: #6b6b70; --ok: #2e7d32;
    --accent: #3451b2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151517; --panel: #1e1e21; --text: #ececee; --muted: #9a9aa2; --border: #33333a;
      --code-bg: #26262b; --high: #ef6b6b; --medium: #e0a040; --low: #9a9aa2; --ok: #6cc070;
      --accent: #8ea2ff;
    }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text);
         font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 32px 16px 64px; }
  h1 { font-size: 1.6rem; margin: 0 0 4px; }
  h2 { font-size: 1.15rem; margin: 40px 0 12px; }
  .meta { color: var(--muted); font-size: .9rem; }
  .meta code { color: var(--text); }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
           gap: 12px; margin: 24px 0; }
  .card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
          padding: 14px 16px; }
  .card .n { font-size: 1.7rem; font-weight: 650; font-variant-numeric: tabular-nums; }
  .card .l { color: var(--muted); font-size: .85rem; }
  table { border-collapse: collapse; width: 100%; background: var(--panel);
          border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  th, td { text-align: left; padding: 8px 12px; border-bottom: 1px solid var(--border);
           font-variant-numeric: tabular-nums; }
  th { font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  td.num, th.num { text-align: right; }
  .zero { color: var(--muted); }
  details.finding { background: var(--panel); border: 1px solid var(--border);
                    border-radius: 8px; margin: 10px 0; }
  details.finding > summary { cursor: pointer; padding: 12px 16px; list-style: none;
                              display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  details.finding > summary::-webkit-details-marker { display: none; }
  details.finding[open] > summary { border-bottom: 1px solid var(--border); }
  .sev { font-size: .75rem; font-weight: 700; text-transform: uppercase; min-width: 56px; }
  .sev.high { color: var(--high); } .sev.medium { color: var(--medium); } .sev.low { color: var(--low); }
  .ep { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-weight: 600; }
  .msg { flex: 1 1 320px; }
  .tag { font-size: .75rem; border: 1px solid var(--border); border-radius: 999px;
         padding: 1px 8px; color: var(--muted); white-space: nowrap; }
  .body { padding: 12px 16px 16px; }
  .body h3 { font-size: .8rem; text-transform: uppercase; letter-spacing: .04em;
             color: var(--muted); margin: 16px 0 6px; }
  pre { background: var(--code-bg); border-radius: 6px; padding: 10px 12px; margin: 0;
        overflow-x: auto; font: 12.5px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        white-space: pre-wrap; word-break: break-word; }
  .curl { position: relative; }
  .curl button { position: absolute; top: 6px; right: 6px; font: inherit; font-size: .75rem;
                 background: var(--panel); color: var(--text); border: 1px solid var(--border);
                 border-radius: 4px; padding: 2px 8px; cursor: pointer; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 760px) { .grid2 { grid-template-columns: 1fr; } }
  .none { color: var(--ok); }
  footer { margin-top: 48px; color: var(--muted); font-size: .85rem; }
</style>
</head>
<body>
<main>
  <h1>{{ report.spec_title }}</h1>
  <div class="meta">
    target <code>{{ report.base_url }}</code> · seed <code>{{ report.seed }}</code> ·
    strategies <code>{{ report.strategies | map(attribute="value") | join(", ") }}</code> ·
    started {{ report.started_at }} · apitest {{ report.tool_version }}
  </div>

  <div class="cards">
    <div class="card"><div class="n">{{ total_cases }}</div><div class="l">test cases</div></div>
    <div class="card"><div class="n">{{ report.request_count }}</div><div class="l">requests</div></div>
    <div class="card"><div class="n">{{ with_findings }}</div><div class="l">cases with findings</div></div>
    <div class="card"><div class="n">{{ unique }}</div><div class="l">unique findings</div></div>
    <div class="card"><div class="n">{{ "%.1f" | format(report.duration_s) }}s</div><div class="l">duration</div></div>
  </div>

  <h2>Summary</h2>
  <table>
    <thead><tr><th>Category</th><th class="num">Unique</th><th class="num">Occurrences</th><th>Found by</th></tr></thead>
    <tbody>
    {% for section in sections %}
      {% set occurrences = section.groups | sum(attribute="count") %}
      <tr>
        <td><a href="#{{ section.category }}">{{ section.title }}</a></td>
        <td class="num {{ 'zero' if not section.groups }}">{{ section.groups | length }}</td>
        <td class="num {{ 'zero' if not occurrences }}">{{ occurrences }}</td>
        <td>
          {% set ns = namespace(found=[]) %}
          {% for g in section.groups %}{% for s in g.strategies %}{% if s.value not in ns.found %}{% set ns.found = ns.found + [s.value] %}{% endif %}{% endfor %}{% endfor %}
          {{ ns.found | join(", ") or "-" }}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  {% for section in sections %}
  <h2 id="{{ section.category }}">{{ section.title }} ({{ section.groups | length }})</h2>
  {% if not section.groups %}
    <p class="none">No findings.</p>
  {% endif %}
  {% for group in section.groups %}
    {% set f = group.example %}
    <details class="finding">
      <summary>
        <span class="sev {{ f.severity.value }}">{{ f.severity.value }}</span>
        <span class="ep">{{ f.endpoint }}</span>
        <span class="msg">{{ f.message }}</span>
        <span class="tag">{{ f.check }}</span>
        {% if f.status %}<span class="tag">{{ f.status }}</span>{% endif %}
        {% for s in group.strategies %}<span class="tag">{{ s.value }}</span>{% endfor %}
        {% if f.shrunk %}<span class="tag">shrunk</span>{% endif %}
        {% if group.count > 1 %}<span class="tag">×{{ group.count }}</span>{% endif %}
      </summary>
      <div class="body">
        <div class="meta">test case <code>{{ f.test_case_id }}</code> · technique <code>{{ f.technique }}</code></div>
        <h3>Reproduce</h3>
        <div class="curl"><pre>{{ f.curl }}</pre><button type="button" onclick="copyCurl(this)">copy</button></div>
        <div class="grid2">
          <div>
            <h3>Request</h3>
            <pre>{{ f.request.method }} {{ f.request.url }}
{% for k, v in f.request.headers.items() %}{{ k }}: {{ v }}
{% endfor %}{% if f.request.body %}
{{ f.request.body | pretty }}{% endif %}</pre>
          </div>
          <div>
            <h3>Response</h3>
            {% if f.response %}
            <pre>{{ f.response.status }} · {{ "%.0f" | format(f.response.elapsed_ms) }} ms
{% for k, v in f.response.headers.items() %}{{ k }}: {{ v }}
{% endfor %}{% if f.response.body %}
{{ f.response.body | pretty }}{% endif %}</pre>
            {% else %}
            <pre>(no response)</pre>
            {% endif %}
          </div>
        </div>
      </div>
    </details>
  {% endfor %}
  {% endfor %}

  {% if report.skipped or report.notes or report.errors %}
  <h2>Notes</h2>
  <ul>
    {% for r in report.errors %}<li>error: {{ r.test_case.endpoint }}: {{ r.error }}</li>{% endfor %}
    {% for n in report.notes %}<li>{{ n }}</li>{% endfor %}
    {% for s in report.skipped %}<li>skipped: {{ s }}</li>{% endfor %}
  </ul>
  {% endif %}

  <footer>Replay this run exactly with <code>--seed {{ report.seed }}</code>.</footer>
</main>
<script>
  function copyCurl(button) {
    const text = button.previousElementSibling.textContent;
    navigator.clipboard.writeText(text).then(() => {
      button.textContent = "copied";
      setTimeout(() => { button.textContent = "copy"; }, 1200);
    });
  }
</script>
</body>
</html>
